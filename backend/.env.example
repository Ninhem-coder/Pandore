# Pandore backend configuration.
# Copy this file to `backend/.env` (git-ignored) and fill in your own values.
# Never commit real values: this template must only ever contain placeholders.
# Full reference: docs/configuration.md

# ── Microsoft authentication ────────────────────────────────────────────────────────────
# "client_credentials" (default): app-only access with a client secret (two app
# registrations, one for Microsoft Defender for Endpoint and one for Microsoft Graph/Intune).
# "interactive": delegated sign-in through a dedicated public-client app registration
# (no secret stored). See docs/installation.md.
AUTH_MODE=client_credentials

# Microsoft Defender for Endpoint app registration (WindowsDefenderATP API permissions).
MDE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MDE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MDE_CLIENT_SECRET=replace-with-your-client-secret

# Microsoft Graph / Intune app registration (Microsoft Graph API permissions).
AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_SECRET=replace-with-your-client-secret

# ── Optional API endpoint overrides (defaults shown) ────────────────────────────────────
# MDE_API_BASE=https://api.securitycenter.microsoft.com
# GRAPH_API_BASE=https://graph.microsoft.com/v1.0
# GRAPH_API_BETA=https://graph.microsoft.com/beta

# ── Web server ──────────────────────────────────────────────────────────────────────────
# Interface the API listens on (port 8000). Keep 127.0.0.1 unless remote access is intended.
# API_HOST=127.0.0.1
# Allowed CORS origin (the Vite dev server). The dev server also proxies /api, so this is
# only a fallback.
# CORS_ORIGIN=http://localhost:5173
# Set to true only when the backend is served over HTTPS (marks the session cookie Secure).
# SESSION_COOKIE_SECURE=false

# ── Vanitas integration (optional — the self-hosted endpoint agent in endpoint-agent/) ──
# URL the Pandore backend uses to reach the Vanitas server (server-to-server only).
# VANITAS_SERVER_URL=https://localhost:8443
# CA certificate used to verify the Vanitas server's TLS certificate.
# Default: endpoint-agent/server/data/ca/ca.pem
# VANITAS_CA_CERT_PATH=C:\path\to\Pandore\endpoint-agent\server\data\ca\ca.pem
# Shared secret sent as the X-Shell-Token header on every dashboard-facing Vanitas route.
# Must be IDENTICAL to SHELL_SESSION_TOKEN in endpoint-agent/server/.env. Leave empty to
# disable the integration (the Vanitas server then refuses every dashboard request).
VANITAS_SHELL_TOKEN=
# URL that the AGENTS use to reach the Vanitas server (shown on the "Add a device" page).
# Must be reachable from the endpoints, unlike VANITAS_SERVER_URL.
# VANITAS_AGENT_SERVER_URL=https://vanitas.example.local:8443

# ── Vanitas e-mail alerts (optional — leave SMTP_HOST empty to disable) ─────────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=pandore@example.com
# SMTP_TO=it-team@example.com

# ── Background jobs (defaults shown) ────────────────────────────────────────────────────
# HISTORY_SNAPSHOT_CHECK_SECONDS=3600     # daily metrics snapshot check interval
# WATCHLIST_REFRESH_SECONDS=3600          # watched-CVE refresh interval
# VANITAS_ALERT_CHECK_SECONDS=3600        # Vanitas alert evaluation interval
# VANITAS_ALERT_STALE_HOURS=12            # agent considered silent after this many hours
# VANITAS_ALERT_CERT_WARNING_DAYS=30      # warn before an agent certificate expires
# VANITAS_PURGE_RETENTION_DAYS=90         # Vanitas history retention
# VANITAS_PURGE_CHECK_SECONDS=86400       # Vanitas purge interval

# ── Win32 app packaging (optional) ──────────────────────────────────────────────────────
# Path to Microsoft's IntuneWinAppUtil.exe (Win32 Content Prep Tool), required by the
# "Add an application" packaging wizard. Install it outside this repository.
# INTUNEWIN_TOOL_PATH=C:\Tools\IntuneWinAppUtil\IntuneWinAppUtil.exe
