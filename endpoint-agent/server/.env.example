# Vanitas server configuration.
# Copy this file to `endpoint-agent/server/.env` (git-ignored) and fill in your own values.

# Optional free NVD API key (https://nvd.nist.gov/developers/request-an-api-key).
# Raises the allowed request rate from one call every 6 s to one every 0.6 s.
# CVE matching also works without a key, just more slowly.
NVD_API_KEY=

# How often the background CVE matching runs, in hours.
CVE_REFRESH_INTERVAL_HOURS=12

# Passphrase protecting the certificate authority's private key at rest
# (data/ca/ca-key.pem, created by scripts/generate_ca.py). This is the most sensitive
# secret of the platform: together with ca-key.pem it allows issuing certificates that
# impersonate legitimate agents. Choose a strong passphrase. If you suspect it leaked,
# change it and regenerate the CA (this invalidates every issued certificate).
CA_KEY_PASSPHRASE=

# Shared secret required in the X-Shell-Token header on every dashboard-facing route
# (agent routes use mTLS instead). Generate a random value, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Copy the SAME value into backend/.env (VANITAS_SHELL_TOKEN). Left empty, every
# dashboard route answers 401 (deny by default).
SHELL_SESSION_TOKEN=

# Listening interface and port of scripts/run_server.py (defaults shown).
# HOST=127.0.0.1
# PORT=8443
